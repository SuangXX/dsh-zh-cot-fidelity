{
  "name": "dsh-zh-cot-fidelity",
  "version": "1.5.0",
  "description": "全局系统提示词插件：中文思维链、内容保真、反八股，14 组规则全场景生效；规则文本可编辑，改完即生效",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./config": "./config.js",
    "./entries": "./entries.js",
    "./prompt": "./prompt.js",
    "./audit": "./audit.js",
    "./contract": "./contract.js",
    "./commands": "./commands.js",
    "./ui": "./ui.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "config.js",
    "entries.js",
    "prompt.js",
    "audit.js",
    "contract.js",
    "commands.js",
    "ui.js",
    "client.js",
    "cordis.patch.yml",
    "rules/*.md",
    "locale/*.json",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "prompt-entries",
    "chinese",
    "translation",
    "content-fidelity",
    "anti-cliche",
    "audit"
  ],
  "license": "MIT",
  "author": "SuangXX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuangXX/dsh-zh-cot-fidelity.git"
  },
  "homepage": "https://github.com/SuangXX/dsh-zh-cot-fidelity#readme",
  "bugs": {
    "url": "https://github.com/SuangXX/dsh-zh-cot-fidelity/issues"
  }
}
